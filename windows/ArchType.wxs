<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArchType 的 Windows 安装包（WiX v4）。

  COM + CTF TIP 由 MSI 直接写注册表，不用 CustomAction 调 DllRegisterServer：
  卸载时 MSI 会按组件回滚，不会留半截注册项。

  用户输入法列表按用户存：安装后给当前用户跑一次 enable-profile，其余用户在
  下次登录时由 Active Setup 补上；卸载前给当前用户跑 disable-profile，撤掉条目。

  构建：wix build -arch x64 -o ArchType.msi -d Version=0.8.0 -d SourceDir=... -d DataDir=... ArchType.wxs
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ArchType" Manufacturer="ArchType" Version="$(var.Version)"
           UpgradeCode="7C2B6D1E-9F4A-4C3B-8E21-5A6D7F0C9B12"
           Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="已经装了更新的 ArchType。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- 当前用户的输入法条目：安装后立刻写，卸载前删掉。
         UserSID 是 SYSTEM 时（无人值守的机器级安装）跳过，不然会写到 SYSTEM 自己的 HKCU。 -->
    <CustomAction Id="EnableProfileNow" FileRef="archtype_exe" ExeCommand="--enable-profile"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <CustomAction Id="DisableProfile" FileRef="archtype_exe" ExeCommand="--disable-profile"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="EnableProfileNow" After="InstallFiles"
              Condition="NOT Installed AND NOT REMOVE AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
      <Custom Action="DisableProfile" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="ArchType">
        <!-- 输入法本体：TSF COM 服务 + 命令行工具（64 位） -->
        <Component Id="InputMethod" Guid="3A6F1C2D-8B4E-4A79-9C31-5E2F7D0B6A18">
          <File Id="tsf_dll" Source="$(var.SourceDir)\archtype_tsf.dll" KeyPath="yes" />
          <File Id="archtype_exe" Source="$(var.SourceDir)\archtype.exe" />
        </Component>

        <!-- 32 位应用的输入法（WOW6432Node 注册由 32 位组件自动重定向） -->
        <Component Id="InputMethod32" Guid="B71E4D08-3C6A-4F92-A05D-8E2B7A1C9F43" Bitness="always32">
          <File Id="tsf_dll32" Source="$(var.X86Dir)\archtype_tsf.dll" Name="archtype_tsf32.dll" KeyPath="yes" />
        </Component>

        <?if $(var.SettingsExe) != "" ?>
        <!-- 跨平台设置界面（nsh 打的 Windows 版） -->
        <Component Id="Settings" Guid="C92A5E17-4D8B-4A26-B7C3-0F6E1D8B4A59">
          <File Id="settings_exe" Source="$(var.SettingsExe)" Name="ArchType 设置.exe" KeyPath="yes" />
        </Component>
        <?endif?>

        <!-- 词库与语言模型（和 Linux/macOS 安装包同一份数据） -->
        <Component Id="DataFiles" Guid="5D8B2A41-6C3F-4E9D-A128-7B4F0C6E3D92">
          <File Id="lexicon" Source="$(var.DataDir)\lexicon.tsv" KeyPath="yes" />
          <File Id="english" Source="$(var.DataDir)\english.txt" />
          <File Id="words_lm" Source="$(var.DataDir)\words.lm" />
          <!-- 简繁对照表不在 dist/data 里（data 任务不复制），直接取仓库里的 core/data/s2t.tsv -->
          <File Id="s2t" Source="$(var.RepoDir)\core\data\s2t.tsv" />
          <File Id="wubi" Source="$(var.DataDir)\wubi86.tsv" />
          <File Id="nnlm" Source="$(var.DataDir)\nnlm.bin" />
        </Component>

        <!-- COM 注册 + CTF TIP + 安装目录（DLL 在宿主进程里，靠它找资源） -->
        <!-- 32 位视图的 COM 与 CTF 注册 -->
        <Component Id="Registration32" Guid="D35F8A26-5E9C-4B17-A8D4-1B7C2E6F9A03" Bitness="always32">
          <RegistryKey Root="HKCR" Key="CLSID\{6F2D3C1A-7B4E-4C2D-9E31-2A5B8F0C7D11}">
            <RegistryValue Type="string" Value="ArchType 拼音" KeyPath="yes" />
            <RegistryKey Key="InprocServer32">
              <RegistryValue Type="string" Value="[INSTALLDIR]archtype_tsf32.dll" />
              <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
            </RegistryKey>
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\{6F2D3C1A-7B4E-4C2D-9E31-2A5B8F0C7D11}">
            <RegistryValue Name="Enable" Type="integer" Value="1" />
          </RegistryKey>
        </Component>

        <!-- 其余用户登录时自动把 ArchType 加进该用户的中文输入法列表
             （Active Setup：每个用户只跑一次；Version 变了会重跑，用于升级后重启用） -->
        <Component Id="EnableProfile" Guid="2C8A4E19-6D3F-4B57-9A20-8C1E5F3D7B64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Active Setup\Installed Components\ArchTypeInputMethod">
            <RegistryValue Name="StubPath" Type="string" Value="&quot;[INSTALLDIR]archtype.exe&quot; --enable-profile" KeyPath="yes" />
            <RegistryValue Name="Version" Type="string" Value="$(var.Version),0" />
            <RegistryValue Name="IsInstalled" Type="integer" Value="1" />
            <RegistryValue Name="Locale" Type="string" Value="*" />
          </RegistryKey>
        </Component>

        <Component Id="Registration" Guid="9E4C7B15-2D6A-4F38-B05C-1A8E6F3D2C74">
          <RegistryKey Root="HKLM" Key="SOFTWARE\ArchType">
            <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
          </RegistryKey>
          <RegistryKey Root="HKCR" Key="CLSID\{6F2D3C1A-7B4E-4C2D-9E31-2A5B8F0C7D11}">
            <RegistryValue Type="string" Value="ArchType 拼音" />
            <RegistryKey Key="InprocServer32">
              <RegistryValue Type="string" Value="[INSTALLDIR]archtype_tsf.dll" />
              <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
            </RegistryKey>
            <RegistryKey Key="Implemented Categories\{34745C63-B2F0-4784-8B67-5E12C8701A31}" />
            <RegistryKey Key="Implemented Categories\{13A016DF-560B-46CD-947A-4C3AF1E0E35D}" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\{6F2D3C1A-7B4E-4C2D-9E31-2A5B8F0C7D11}">
            <RegistryValue Name="Enable" Type="integer" Value="1" />
            <RegistryKey Key="LanguageProfile\0x00000804\{4A8B2C6D-1F3E-4A9B-8C7D-2E5F6A7B8C9D}">
              <RegistryValue Name="Description" Type="string" Value="ArchType 拼音" />
            </RegistryKey>
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="ArchType" Level="1">
      <ComponentRef Id="InputMethod" />
      <ComponentRef Id="DataFiles" />
      <ComponentRef Id="Registration" />
      <ComponentRef Id="InputMethod32" />
      <ComponentRef Id="Registration32" />
      <ComponentRef Id="EnableProfile" />
      <?if $(var.SettingsExe) != "" ?><ComponentRef Id="Settings" /><?endif?>
    </Feature>
  </Package>
</Wix>
